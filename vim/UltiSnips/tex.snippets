# MATH

snippet ff "Fractions" A
\frac{$1}{$2}$0
endsnippet

snippet ss "subseteq"
\subseteq$0
endsnippet

snippet sp "superseteq"
\supseteq$0
endsnippet

snippet st "set"
\qty{$1}$0
endsnippet

snippet ov "overline"
\overline{$1}$0
endsnippet

snippet bgs "big symmetric"
\big$1$2\big$1$0
endsnippet

snippet bggs "bigg symmetric"
\bigg$1$2\bigg$1$0
endsnippet

snippet pp "commented pause"
%\pause$0
endsnippet

# ENVIRONMENTS

snippet tex "set up tex document" bA
\documentclass[$1]{$2}
\usepackage{$3}
\begin{document}
$0
\end{document}
endsnippet

snippet dm "Display math mode" 
\[
    $1
\]
$0
endsnippet

snippet ii "Inline math mode" A
\$$1\$$0
endsnippet

snippet al "Align"
\begin{align*}
$2
\end{align*}
$

endsnippet

snippet enar "arabic enumeration"
\begin{enumerate}[label=\arabic*.]
    $1
\end{enumerate}
$0
endsnippet

snippet enal "alphabetical enumeration"
\begin{enumerate}[label=\alph*.]
    $1
\end{enumerate}
$0
endsnippet

snippet be "begin"
\begin{$1}
    $2
\end{$1}
$0
endsnippet

# FONT

snippet tt "typewriter text" A
\texttt{$1}$0
endsnippet

snippet itt "italic text" A
\textit{$1}$0
endsnippet

snippet bt "bold text" A
\textbf{$1}$0
endsnippet

# MISC

snippet link "hyperrefing"
\hyperref[${1:label}]{${2:text}}$0
endsnippet

snippet flink "hyperrefing for the folland sols"
\hyperref[prob:$1-$2]{Problem $1.$2}$0
endsnippet
